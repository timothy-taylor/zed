{
  "colorize_brackets": false,
  "context_servers": {
    "effect-docs": {
      "enabled": true,
      "command": "npx",
      "args": ["-y", "effect-mcp@latest"],
      "env": {}
    }
  },
  "edit_predictions": {
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "show_edit_predictions": false,
  "features": {
    "edit_prediction_provider": "zed"
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    },
    "model_parameters": []
  },
  "language_models": {
    "bedrock": {
      "authentication_method": "named_profile",
      "profile": "default",
      "region": "us-west-2"
    }
  },

  "theme": "ZedHacker Matrix",
  "vim_mode": true,
  "ui_font_family": "Hasklug Nerd Font Mono",
  "ui_font_size": 13,
  "buffer_font_family": "Hasklug Nerd Font Mono",
  "buffer_font_weight": 400,
  "buffer_line_height": "comfortable",
  "buffer_font_size": 14.0,
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "vertical_scroll_margin": 0,
  "unnecessary_code_fade": 0.7,
  "minimap": { "show": "never" },
  "project_panel": {
    "dock": "left"
  },
  "terminal": {
    "dock": "bottom",
    "cursor_shape": "bar",
    "font_size": 13,
    "font_weight": 300
  },
  "scrollbar": {
    "show": "never"
  },
  "file_scan_inclusions": [".schema-temp"],
  "languages": {
    "Markdown": {
      "soft_wrap": "editor_width"
    },
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      },
      "format_on_save": "on"
    }
  }
}
